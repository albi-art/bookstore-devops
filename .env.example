WOODPECKER_GITHUB_CLIENT=your-github-oauth-client-id
WOODPECKER_GITHUB_SECRET=your-github-oauth-client-secret

# ============================================
# Woodpecker CI Server Configuration
# ============================================
# Public HTTPS URL from localhost.run tunnel or ngrok
WOODPECKER_HOST=https://your-tunnel-domain.lhr.life

