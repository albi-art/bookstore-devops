# ============================================
# Woodpecker CI GitHub OAuth Credentials
# ============================================
WOODPECKER_GITHUB_CLIENT=your-github-oauth-client-id
WOODPECKER_GITHUB_SECRET=your-github-oauth-client-secret

# ============================================
# Woodpecker CI Server Configuration
# ============================================
# Public HTTPS URL from Cloudflare Tunnel (npx --yes cloudflared tunnel --url http://localhost:8000)
WOODPECKER_HOST=https://your-tunnel-domain.trycloudflare.com



